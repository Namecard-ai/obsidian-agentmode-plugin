{
	"name": "obsidian-agent-plugin",
	"version": "1.0.0",
	"description": "An AI-powered assistant plugin for Obsidian (https://obsidian.md) that provides intelligent chat functionality with context-aware file integration.",
	"main": "main.js",
	"scripts": {
		"dev": "ENV_MODE=development node esbuild.config.mjs",
		"dev:local": "ENV_MODE=local node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && ENV_MODE=local node esbuild.config.mjs production",
		"build:local": "tsc -noEmit -skipLibCheck && ENV_MODE=local node esbuild.config.mjs production",
		"build:dev": "tsc -noEmit -skipLibCheck && ENV_MODE=development node esbuild.config.mjs production",
		"build:prod": "tsc -noEmit -skipLibCheck && ENV_MODE=production node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint . --ext .ts,.tsx",
		"lint:fix": "eslint . --ext .ts,.tsx --fix"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^16.11.6",
		"@types/react": "^19.1.4",
		"@types/react-dom": "^19.1.5",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"builtin-modules": "3.3.0",
		"dotenv": "^17.1.0",
		"esbuild": "0.17.3",
		"esbuild-plugin-copy": "^2.1.1",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"@tiptap/extension-mention": "^3.4.4",
		"@tiptap/extension-placeholder": "^3.4.4",
		"@tiptap/pm": "^3.4.4",
		"@tiptap/react": "^3.4.4",
		"@tiptap/starter-kit": "^3.4.4",
		"@tiptap/suggestion": "^3.4.4",
		"@types/crypto-js": "^4.2.2",
		"@types/react-syntax-highlighter": "^15.5.13",
		"crypto-js": "^4.2.0",
		"diff": "^8.0.2",
		"js-tiktoken": "^1.0.21",
		"openai": "^5.1.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-markdown": "^10.1.0",
		"react-syntax-highlighter": "^15.6.1",
		"remark-gfm": "^4.0.1"
	}
}
